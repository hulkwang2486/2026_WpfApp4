<Window x:Class="_2026_WpfApp4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="飲料訂購系統" Height="600" Width="800">
	<Grid Margin="15">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- 左側：功能區與飲料菜單 -->
		<Grid Grid.Column="0" Margin="0,0,10,0">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<TextBlock Text="飲料菜單" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

			<!-- 開啟菜單 CSV 按鈕 -->
			<Button x:Name="OpenMenuButton" Grid.Row="1" Content="匯入飲料菜單 (CSV)" Height="35" FontSize="16" Margin="0,0,0,10" Click="OpenMenuButton_Click"/>

			<!-- 盛裝動態產生的飲料項目列表 -->
			<ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
				<StackPanel x:Name="DrinkMenuStackPanel" />
			</ScrollViewer>

			<!-- 用餐方式 -->
			<StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,15,0,15">
				<TextBlock Text="用餐方式：" FontSize="16" VerticalAlignment="Center"/>
				<RadioButton Content="內用" IsChecked="True" FontSize="16" Margin="10,0,10,0" Checked="RadioButton_Checked"/>
				<RadioButton Content="外帶" FontSize="16" Checked="RadioButton_Checked"/>
			</StackPanel>

			<!-- 結帳與儲存 -->
			<Button x:Name="OrderButton" Grid.Row="4" Content="計算總額並儲存訂單" Height="40" FontSize="16" Click="OrderButton_Click"/>
		</Grid>

		<!-- 右側：訂單明細展示區 -->
		<Grid Grid.Column="1" Margin="10,0,0,0">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<TextBlock Text="訂單明細" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

			<Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10" Background="#F9F9F9">
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<TextBlock x:Name="ResultTextBlock" FontSize="16" TextWrapping="Wrap"/>
				</ScrollViewer>
			</Border>
		</Grid>
	</Grid>
</Window>